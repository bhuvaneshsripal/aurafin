VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Used to send the "forgot PIN" one-time code by email from Settings > App
# Lock. Free to set up at https://www.emailjs.com — create an Email Service
# and a template with {{to_email}}, {{otp_code}}, {{expires_in}} variables,
# then paste the IDs below. Without these, the "Forgot PIN?" flow will show
# a clear "not configured" message instead of pretending to send an email.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Used to email someone when you add them under Settings > Shared Access.
# Create a second template on the same EmailJS service with
# {{to_email}}, {{inviter_email}}, {{role}} variables, then paste its ID
# below. Without this, "Send Invite" will show a clear "not configured"
# message instead of silently doing nothing.
VITE_EMAILJS_INVITE_TEMPLATE_ID=
