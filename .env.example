VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Used to send the "forgot PIN" one-time code by email from Settings > App
# Lock. Free to set up at https://www.emailjs.com — create an Email Service
# and a template with {{to_email}}, {{otp_code}}, {{expires_in}} variables,
# then paste the IDs below. Without these, the "Forgot PIN?" flow will show
# a clear "not configured" message instead of pretending to send an email.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Used to email someone when you add them under Settings > Shared Access.
# Create a second template on the same EmailJS service with
# {{to_email}}, {{inviter_email}}, {{role}} variables, then paste its ID
# below. Without this, "Send Invite" will show a clear "not configured"
# message instead of silently doing nothing.
VITE_EMAILJS_INVITE_TEMPLATE_ID=

# Used for the weekly portfolio digest email (Settings > Preferences >
# Notifications > Weekly portfolio digest), sent Saturdays at 10:00 AM IST
# — like Zerodha's weekly summary. Create a third template on the same
# EmailJS service with {{to_email}}, {{net_worth}}, {{week_change}},
# {{week_change_percent}} variables, then paste its ID below. Without
# this, the digest silently won't send (the toggle still saves, but
# nothing goes out until this is configured).
#
# Note: this app has no backend, so the send only happens while someone
# actually has the app open in a browser tab around 10 AM Saturday IST —
# there's no server-side cron keeping time while the app is closed. A
# guaranteed send regardless of whether the app is open would need a real
# backend (e.g. a scheduled Firebase Cloud Function), which requires
# Firebase's paid Blaze plan.
VITE_EMAILJS_DIGEST_TEMPLATE_ID=
