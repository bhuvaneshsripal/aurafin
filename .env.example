VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Used to send the "forgot PIN" one-time code by email from Settings > App
# Lock. Free to set up at https://www.emailjs.com — create an Email Service
# and a template with {{to_email}}, {{otp_code}}, {{expires_in}} variables,
# then paste the IDs below. Without these, the "Forgot PIN?" flow will show
# a clear "not configured" message instead of pretending to send an email.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Used to email someone when you add them under Settings > Shared Access.
# Create a second template on the same EmailJS service with
# {{to_email}}, {{inviter_email}}, {{role}} variables, then paste its ID
# below. Without this, "Send Invite" will show a clear "not configured"
# message instead of silently doing nothing.
VITE_EMAILJS_INVITE_TEMPLATE_ID=

# The weekly portfolio digest (Saturday 10:00 AM IST) is now sent by the server, not by EmailJS.
# Set SMTP_USER and SMTP_PASS as Vercel environment variables instead (see PUSH_SETUP.md).
# VITE_EMAILJS_DIGEST_TEMPLATE_ID is no longer used.

# Feedback form (sidebar > Feedback). Create a 4th template on the same
# EmailJS service with {{message}}, {{from_name}}, {{from_email}}, {{page}}
# variables, set its "To Email" to sribhuvi6264@gmail.com (and Reply-To to
# {{from_email}}), then paste its ID below.
VITE_EMAILJS_FEEDBACK_TEMPLATE_ID=

# --- Push notifications while the app is closed (see PUSH_SETUP.md) ---
# Public key: needed at BUILD time so the browser can subscribe.
VITE_VAPID_PUBLIC_KEY=
# Server-only (Vercel env vars, never VITE_-prefixed):
# VAPID_PUBLIC_KEY=        same value as VITE_VAPID_PUBLIC_KEY
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# FIREBASE_SERVICE_ACCOUNT=   whole service-account JSON on one line
# CRON_SECRET=                long random string; also a GitHub Actions secret
