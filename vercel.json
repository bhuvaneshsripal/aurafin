{
  "rewrites": [
    {
      "source": "/api/market/global-indices",
      "destination": "/api/market/indices?mode=global"
    },
    {
      "source": "/api/market/indian-indices",
      "destination": "/api/market/indices?mode=indian"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(sw.js|index.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}