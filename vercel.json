{
  "rewrites": [
    {
      "source": "/api/market/global-indices",
      "destination": "/api/market/indices?mode=global"
    },
    {
      "source": "/api/market/swing",
      "destination": "/api/market/indices?mode=swing"
    },
    {
      "source": "/api/market/volume",
      "destination": "/api/market/indices?mode=volume"
    },
    {
      "source": "/api/market/indian-indices",
      "destination": "/api/market/indices?mode=indian"
    },
    {
      "source": "/((?!api/|sw[-.]).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(sw-.*|sw.js|index.html|version.json|registerSW.js|manifest.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/whats-new.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/market/valuation.js": {
      "maxDuration": 30
    }
  }
}